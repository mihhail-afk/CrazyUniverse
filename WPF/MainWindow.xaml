<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WPF.ViewModels"
        mc:Ignorable="d"
        Title="CrazyUniverse" Height="550" Width="950">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Animals Management" FontWeight="Bold" Margin="0,0,0,5"/>

            <Button Content="Add Penguin" Command="{Binding AddPenguinCommand}" Margin="0,2"/>
            <Button Content="Add Monkey" Command="{Binding AddMonkeyCommand}" Margin="0,2"/>
            <Button Content="Add Lion" Command="{Binding AddLionCommand}" Margin="0,2"/>
            <Button Content="Add Dragon" Command="{Binding AddDragonCommand}" Margin="0,2"/>
            <Button Content="Add Phoenix" Command="{Binding AddPhoenixCommand}" Margin="0,2"/>
            <Button Content="Add Yeti" Command="{Binding AddYetiCommand}" Margin="0,2"/>

            <Separator Margin="0,10"/>

            <TextBlock Text="Simulation Settings" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Workload (steps):"/>
            <TextBox Text="{Binding Workload, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
            <CheckBox Content="Parallel Mode" IsChecked="{Binding IsParallel}" Margin="0,2,0,10"/>

            <Button Content="Start Simulation" Command="{Binding StartSimulationCommand}" Background="LightGreen" Margin="0,2"/>
            <Button Content="Cancel" Command="{Binding CancelSimulationCommand}" Background="LightCoral" Margin="0,2,0,10"/>

            <TextBlock Text="Search:" Margin="0,5,0,2"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox ItemsSource="{Binding FilteredAnimals}" SelectedItem="{Binding SelectedAnimal}" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Content="Remove Selected" Command="{Binding RemoveCommand}" Width="120" Margin="0,0,10,0"/>
                <Button Content="Crazy Action" Command="{Binding CrazyActionCommand}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Sort by Energy" Command="{Binding SortCommand}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Group by Type" Command="{Binding GroupCommand}" Width="100"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Column="2" Margin="10,0,0,0">
            <TabItem Header="Reports">
                <ListBox ItemsSource="{Binding ReportEntries}" Margin="5"/>
            </TabItem>
            <TabItem Header="Logs">
                <ListBox ItemsSource="{Binding LogEntries}" Margin="5"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>