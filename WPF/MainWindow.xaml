<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo Manager" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Zoo Animals:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="AnimalsListBox" Height="320" SelectionChanged="AnimalsListBox_SelectionChanged"/>
            <Button Content="Add Random Animal" Click="AddAnimal_Click" Margin="0,10,0,0" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Animal Actions &amp; Info:" FontWeight="Bold" Margin="0,0,0,5"/>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5" Height="220" Margin="0,0,0,10">
                <TextBlock x:Name="InfoTextBlock" Text="Select an animal from the list..." TextWrapping="Wrap"/>
            </Border>

            <Button x:Name="SoundButton" Content="Make Sound" Click="SoundButton_Click" Height="30" Margin="0,0,0,5" IsEnabled="False"/>
            <Button x:Name="ActionButton" Content="Crazy Action" Click="ActionButton_Click" Height="30" Margin="0,0,0,5" IsEnabled="False"/>
            <Button x:Name="InterfaceButton" Content="Interface Action (Swim/Climb)" Click="InterfaceButton_Click" Height="30" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>